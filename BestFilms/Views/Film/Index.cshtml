@model IEnumerable<BestFilms.Film>

<div class="films">
    @foreach (var film in Model)
    {
        <div class="card">
            <div><img src="~/Poster/@film.Poster" width="400px" /></div>
            <div class="filmInfo">
                <p class="nameFilm">@film.Name</p>
                <p>@film.Genre</p>
                <p class="yearFilm">@film.Year</p>
                <p>Режисер: @film.FilmDirector</p>
                <a asp-action="Details" asp-route-i="@film.Id">Детальніше</a>
            </div>
        </div>
    }
</div>