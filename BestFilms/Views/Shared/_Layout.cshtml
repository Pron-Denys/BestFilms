<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BestFilms</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BestFilms.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/BestFilmsStyle.css" asp-append-version="true" />
</head>
<body>
    <div class="conteiner">
        <header>
            <a asp-controller="Film" asp-action="Index"><img src="~/Image/free-icon-technology-16555969 (2).png" />10 кращих фільмів</a>
            <a asp-controller="Film" asp-action="Create" class="create btn">Додати фільм +</a>
        </header>
        @RenderBody()
        <footer>
            <hr/>
            <p>&copy; @DateTime.Now.Year - Десять кращих фільмів</p>
        </footer>
    </div>
    @await RenderSectionAsync("Scripts", false);
</body>
</html>
